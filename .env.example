# =============================================================================
# COSMOS — Environment Variables Example
# Copy this file to .env and fill in real values before running the project.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared / Root
# -----------------------------------------------------------------------------

# Application environment: development | staging | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# apps/api — Express API Gateway
# -----------------------------------------------------------------------------

# Port the API server listens on
# Default: 3001
PORT=3001

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cosmos:changeme@localhost:5432/cosmos_dev

# Redis connection string
# Format: redis://[:PASSWORD@]HOST:PORT[/DB]
REDIS_URL=redis://localhost:6379

# JWT signing secret — must be at least 256 bits (32+ random bytes)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars_minimum_openssl_rand_hex_32

# Access token time-to-live (ms, or zeit/ms string)
# Default: 15m
JWT_ACCESS_TTL=15m

# Refresh token time-to-live (ms, or zeit/ms string)
# Default: 7d
JWT_REFRESH_TTL=7d

# AES-256-GCM encryption key for sensitive birth data stored in the database
# Must be exactly 64 hex characters (32 bytes = 256 bits)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_exactly_64_hex_characters_openssl_rand_hex_32

# Base URL of the calc (Python FastAPI) service
# Default: http://localhost:3002
CALC_SERVICE_URL=http://localhost:3002

# Anthropic API key — required for AI synthesis endpoint
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-with-your-anthropic-api-key

# OpenCage Geocoding API key — required for birth location geocoding
# Obtain from: https://opencagedata.com/
OPENCAGE_API_KEY=replace_with_your_opencage_api_key

# Logging level: fatal | error | warn | info | debug | trace
# Default: info
LOG_LEVEL=info

# Rate limit sliding window duration in milliseconds
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW=60000

# Maximum number of requests allowed per window (anonymous users)
# Default: 100
RATE_LIMIT_MAX=100

# Sentry DSN for error tracking (optional — leave blank to disable)
# Obtain from: https://sentry.io/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# apps/calc — Python FastAPI Calculation Engine
# -----------------------------------------------------------------------------

# Port the calc service listens on
# Default: 3002
# PORT=3002

# Filesystem path to Swiss Ephemeris data files
# Default: /usr/share/swisseph
# When running locally without Docker, point to your local ephe data directory.
EPHE_PATH=/usr/share/swisseph

# Logging level for the calc service
# Default: info
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# apps/web — Next.js Frontend
# -----------------------------------------------------------------------------

# Base URL of the API service, accessible from the browser
# In production, this should be your public API domain (e.g. https://api.cosmos.app)
NEXT_PUBLIC_API_URL=http://localhost:3001

# OpenCage API key for client-side geocoding, if used directly in the browser
# Leave blank if geocoding is handled server-side by apps/api only
NEXT_PUBLIC_OPENCAGE_API_KEY=
